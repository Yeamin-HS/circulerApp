# Copy to .env and fill in. Never commit .env.
# Everything here must stay on a free tier (SOP hard rule 1).

# --- Backend ---
# Neon Postgres connection string (pgvector enabled)
DATABASE_URL=

# Secret used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# "ollama" for local development, "groq" for production
LLM_PROVIDER=ollama

# Local Ollama server (dev)
OLLAMA_BASE_URL=http://localhost:11434

# Groq free-tier key (prod only)
GROQ_API_KEY=

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
